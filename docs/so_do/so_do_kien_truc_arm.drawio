="hw28" target="hw30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hw55" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="DONE" edge="1" source="hw30" target="hw29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hw56" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.101;entryY=1;entryDx=0;entryDy=0;dashed=1;" value="JTAG (nạp)" edge="1" source="hw32" target="hw2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hw57" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;exitX=0.244;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="UART0" edge="1" source="hw2" target="hw33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hw58" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;exitX=0.396;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="GPIO" edge="1" source="hw2" target="hw34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hw59" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.891;entryY=1;entryDx=0;entryDy=0;dashed=1;" value="AHB2 (dự phòng)" edge="1" source="hw35" target="hw2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hw60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;" value="&lt;b&gt;Màu:&lt;/b&gt; xanh lá = mạch cứng của MCU · tím = nằm trong / dùng tài nguyên FPGA · cam = logic của nhóm · xanh dương = ngoài chip" vertex="1"><mxGeometry x="30" y="930" width="860" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="sw" name="2. Phần mềm trên lõi ARM (firmware C)"><mxGraphModel dx="1600" dy="950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sw1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Kiến trúc phần mềm trên lõi ARM — firmware C (Keil MDK hoặc GOWIN MCU Designer)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Đề xuất, chưa thực hiện. Số có nhãn [ước tính] chưa đo.&lt;/i&gt;" vertex="1"><mxGeometry x="30" y="15" width="1600" height="60" as="geometry" /></mxCell><mxCell id="sw2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Tầng ứng dụng" vertex="1"><mxGeometry x="30" y="90" width="1180" height="210" as="geometry" /></mxCell><mxCell id="sw3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Máy trạng thái an toàn&lt;/b&gt;&lt;hr&gt;giám sát → nghi ngờ (bỏ phiếu 2/3)&lt;br&gt;→ xác nhận → đếm ngược khi bất động&lt;br&gt;→ báo động · hủy · SOS" vertex="1"><mxGeometry x="55" y="135" width="270" height="140" as="geometry" /></mxCell><mxCell id="sw4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Xác nhận ngã (tầng 2)&lt;/b&gt;&lt;hr&gt;dấu hiệu vật lý theo vị trí đeo&lt;br&gt;(pha rơi, va chạm, tốc độ quay,&lt;br&gt;bất động sau ngã) · dùng mẫu thô 100 Hz" vertex="1"><mxGeometry x="340" y="135" width="270" height="140" as="geometry" /></mxCell><mxCell id="sw5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Web server&lt;/b&gt; (qua UART0 + lệnh AT)&lt;hr&gt;GET / (trang nén)&lt;br&gt;GET /data (trạng thái)&lt;br&gt;POST /huy · /bat" vertex="1"><mxGeometry x="625" y="135" width="270" height="140" as="geometry" /></mxCell><mxCell id="sw6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Tự kiểm khi khởi động&lt;/b&gt;&lt;br&gt;so kết quả bộ tăng tốc với bảng mẫu" vertex="1"><mxGeometry x="910" y="135" width="280" height="65" as="geometry" /></mxCell><mxCell id="sw7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;CNN phần mềm (đối chứng)&lt;/b&gt;&lt;br&gt;cùng mạng, so với bộ tăng tốc" vertex="1"><mxGeometry x="910" y="210" width="280" height="65" as="geometry" /></mxCell><mxCell id="sw8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Tầng xử lý dữ liệu" vertex="1"><mxGeometry x="30" y="320" width="1180" height="160" as="geometry" /></mxCell><mxCell id="sw9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Tiền xử lý (tầng 1)&lt;/b&gt;&lt;br&gt;đổi trục theo vị trí đeo · trừ độ lệch · lọc · giảm mẫu · lượng tử INT8&lt;br&gt;→ dữ liệu mới gửi sang bộ tăng tốc" vertex="1"><mxGeometry x="55" y="365" width="560" height="95" as="geometry" /></mxCell><mxCell id="sw10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Bỏ phiếu&lt;/b&gt;&lt;br&gt;nhận lớp + điểm từ bộ tăng tốc&lt;br&gt;≥ 2/3 cửa sổ báo ngã" vertex="1"><mxGeometry x="630" y="365" width="280" height="95" as="geometry" /></mxCell><mxCell id="sw11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Hiệu chỉnh con quay,&lt;br&gt;nhận dạng tư thế&lt;/b&gt;&lt;br&gt;(hiển thị)" vertex="1"><mxGeometry x="925" y="365" width="265" height="95" as="geometry" /></mxCell><mxCell id="sw12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Tầng driver (ngoại vi)" vertex="1"><mxGeometry x="30" y="500" width="1180" height="160" as="geometry" /></mxCell><mxCell id="sw13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;I²C phần mềm&lt;/b&gt;&lt;br&gt;qua GPIO&lt;br&gt;→ MPU6050, 100 Hz" vertex="1"><mxGeometry x="55" y="545" width="210" height="95" as="geometry" /></mxCell><mxCell id="sw14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Driver bộ tăng tốc&lt;/b&gt;&lt;br&gt;APB2 Master 1 (0x40002400)&lt;br&gt;ngắt USER_INT0" vertex="1"><mxGeometry x="280" y="545" width="260" height="95" as="geometry" /></mxCell><mxCell id="sw15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;UART0 + lệnh AT&lt;/b&gt;&lt;br&gt;→ module WiFi&lt;br&gt;(không chặn)" vertex="1"><mxGeometry x="555" y="545" width="210" height="95" as="geometry" /></mxCell><mxCell id="sw16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;GPIO&lt;/b&gt;&lt;br&gt;còi (← máy trạng thái) · nút&lt;br&gt;LED · công tắc tải cảm biến" vertex="1"><mxGeometry x="780" y="545" width="200" height="95" as="geometry" /></mxCell><mxCell id="sw17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Timer, Watchdog&lt;/b&gt;&lt;br&gt;nhịp 10 ms&lt;br&gt;tự khởi động lại khi treo" vertex="1"><mxGeometry x="995" y="545" width="195" height="95" as="geometry" /></mxCell><mxCell id="sw18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="&lt;b&gt;Phần cứng lõi ARM&lt;/b&gt; (trang 1): Cortex-M3 · NVIC · GPIO · UART0/1 · Timer · Watchdog · APB2 → bộ tăng tốc trên FPGA" vertex="1"><mxGeometry x="30" y="690" width="1180" height="60" as="geometry" /></mxCell><mxCell id="sw19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;" value="Cách chạy và bộ nhớ" vertex="1"><mxGeometry x="1240" y="90" width="430" height="660" as="geometry" /></mxCell><mxCell id="sw20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;" value="&lt;b&gt;Luồng chạy (không dùng RTOS)&lt;/b&gt;&lt;hr&gt;ngắt cảm biến 100 Hz → tiền xử lý&lt;br&gt;ngắt USER_INT0 → đọc kết quả, bỏ phiếu&lt;br&gt;ngắt UART → nhận phản hồi lệnh AT&lt;br&gt;vòng chính: máy trạng thái, tầng 2,&lt;br&gt;web server (từng bước, không chặn)" vertex="1"><mxGeometry x="1265" y="135" width="380" height="170" as="geometry" /></mxCell><mxCell id="sw21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;" value="&lt;b&gt;Ưu tiên&lt;/b&gt;&lt;hr&gt;1. đọc cảm biến, còi (an toàn)&lt;br&gt;2. bộ tăng tốc, bỏ phiếu, tầng 2&lt;br&gt;3. web, lệnh AT (mất WiFi vẫn kêu còi)" vertex="1"><mxGeometry x="1265" y="325" width="380" height="130" as="geometry" /></mxCell><mxCell id="sw22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;" value="&lt;b&gt;Bộ nhớ&lt;/b&gt; [ước tính]&lt;hr&gt;flash ~16–28 / 32 KB&lt;br&gt;(firmware + trang web nén + lệnh AT)&lt;br&gt;RAM ~6–7 / 8 KB" vertex="1"><mxGeometry x="1265" y="475" width="380" height="125" as="geometry" /></mxCell><mxCell id="sw23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=middle;align=center;spacing=4;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;" value="&lt;b&gt;Công cụ&lt;/b&gt;&lt;hr&gt;C → Keil MDK / GMD → .bin&lt;br&gt;Gowin Programmer nạp cùng bitstream" vertex="1"><mxGeometry x="1265" y="620" width="380" height="110" as="geometry" /></mxCell><mxCell id="sw24" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="" edge="1" source="sw9" target="sw10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sw25" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="phiếu" edge="1" source="sw10" target="sw3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sw26" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="xác nhận / bỏ" edge="1" source="sw4" target="sw3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sw27" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" value="trạng thái" edge="1" source="sw3" target="sw5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sw28" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.18;entryY=1;entryDx=0;entryDy=0;" value="mẫu thô" edge="1" source="sw13" target="sw9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sw29" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="dữ liệu mới" edge="1" source="sw9" target="sw14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sw30" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" value="lớp, điểm" edge="1" source="sw14" target="sw10"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>