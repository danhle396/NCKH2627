<mxfile host="Electron" agent="Claude Code" pages="3"><diagram id="ov" name="1. Tổng quan hệ thống (đề xuất)"><mxGraphModel dx="1600" dy="950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ov1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Thiết bị đeo bắp tay phát hiện té ngã — Tang Nano 4K (Cortex-M3 + FPGA) + MPU6050 + module WiFi&lt;/b&gt;&lt;br&gt;&lt;i&gt;Đề xuất, chưa thực hiện (9/11/2026). Số có nhãn [ước tính] chưa đo; [mô phỏng] = mô phỏng RTL 14/10.&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="20" width="1500" height="70" as="geometry" /></mxCell><mxCell id="ov2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;MPU6050&lt;/b&gt;&lt;br&gt;(băng đeo bắp tay)&lt;hr&gt;6 trục, 100 Hz&lt;br&gt;±16 g · ±2000 °/s&lt;br&gt;I²C 0x68 · chân DRDY" vertex="1"><mxGeometry x="40" y="230" width="210" height="140" as="geometry" /></mxCell><mxCell id="ov3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" value="GW1NSR-LV4C — Sipeed Tang Nano 4K (một chip)" vertex="1"><mxGeometry x="290" y="110" width="1060" height="760" as="geometry" /></mxCell><mxCell id="ov4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Cortex-M3 cứng (không FPU) · SRAM 8 KB = 4 BSRAM* · flash 32 KB · chung xung nhịp thạch anh" vertex="1"><mxGeometry x="320" y="150" width="600" height="700" as="geometry" /></mxCell><mxCell id="ov5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="FPGA (4.608 LUT · 10 BSRAM · 16 bộ nhân)" vertex="1"><mxGeometry x="960" y="150" width="370" height="560" as="geometry" /></mxCell><mxCell id="ov6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;① Đọc cảm biến&lt;/b&gt;&lt;br&gt;I²C 400 kHz bằng GPIO (O6)&lt;br&gt;14 B mỗi mẫu" vertex="1"><mxGeometry x="345" y="195" width="250" height="75" as="geometry" /></mxCell><mxCell id="ov7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;② Tiền xử lý&lt;/b&gt;&lt;br&gt;đổi trục bắp tay · trừ độ lệch&lt;br&gt;lọc [1 3 3 1]/8 · 100 → 50 Hz&lt;br&gt;INT8 → 16 mẫu mới mỗi 0,32 s" vertex="1"><mxGeometry x="345" y="300" width="250" height="105" as="geometry" /></mxCell><mxCell id="ov8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Tầng 1 — bỏ phiếu&lt;/b&gt;&lt;br&gt;≥ 2/3 cửa sổ FALL → SUSPECT" vertex="1"><mxGeometry x="345" y="440" width="250" height="75" as="geometry" /></mxCell><mxCell id="ov9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;⑥ Safety FSM&lt;/b&gt;&lt;hr&gt;MONITOR → SUSPECT → XÁC NHẬN&lt;br&gt;→ bất động → đếm ngược 10 s&lt;br&gt;→ BÁO ĐỘNG" vertex="1"><mxGeometry x="345" y="550" width="250" height="120" as="geometry" /></mxCell><mxCell id="ov10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Tầng 2 — 4 dấu hiệu vật lý&lt;/b&gt;&lt;br&gt;(nga.c, mẫu thô 100 Hz)&lt;hr&gt;lịch sử 36 khối × 32 mẫu (11,5 s)&lt;br&gt;xét khi vào SUSPECT, ≤ 4 s" vertex="1"><mxGeometry x="640" y="195" width="255" height="120" as="geometry" /></mxCell><mxCell id="ov11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;③ ⑤ Driver APB&lt;/b&gt;&lt;br&gt;ghi 96 B mẫu mới + START&lt;br&gt;đọc CLASS / SCORE (khi WARM = 8)&lt;br&gt;(đổi mã 1 → 3)" vertex="1"><mxGeometry x="640" y="350" width="255" height="95" as="geometry" /></mxCell><mxCell id="ov12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Tự kiểm khi bật nguồn&lt;/b&gt;&lt;br&gt;8 bước cố định → so CLASS/LOGIT&lt;hr&gt;&lt;b&gt;CNN phần mềm (đối chứng)&lt;/b&gt;&lt;br&gt;cùng N2, đo thời gian, năng lượng" vertex="1"><mxGeometry x="640" y="480" width="255" height="120" as="geometry" /></mxCell><mxCell id="ov13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;⑦ Web server trên M3&lt;/b&gt;&lt;br&gt;(qua lệnh AT, UART)&lt;hr&gt;GET / → trang web nén trong flash&lt;br&gt;GET /data → JSON mỗi 300 ms&lt;br&gt;POST /huy · /bat" vertex="1"><mxGeometry x="640" y="700" width="255" height="115" as="geometry" /></mxCell><mxCell id="ov14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Cổng APB (O4)&lt;/b&gt;&lt;br&gt;APB2 Master 1 · 0x40002400 · 256 B&lt;hr&gt;CTRL · STATUS · CLASS · SCORE&lt;br&gt;LOGIT · CYCLES · NEW_DATA (96 B) · WARM" vertex="1"><mxGeometry x="985" y="190" width="320" height="110" as="geometry" /></mxCell><mxCell id="ov15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;④ Bộ tăng tốc kiểu mới&lt;/b&gt;&lt;br&gt;tính tăng dần, giữ kết quả cũ · 1 làn MAC&lt;br&gt;~1,3–1,7 ms ở 27 MHz [ước tính]" vertex="1"><mxGeometry x="985" y="330" width="320" height="95" as="geometry" /></mxCell><mxCell id="ov16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Đệm đặc trưng 2.048 × 8 — 1 BSRAM (O1)&lt;/b&gt;&lt;br&gt;L1 · L2 · L3, giữ giữa các lần" vertex="1"><mxGeometry x="985" y="455" width="320" height="80" as="geometry" /></mxCell><mxCell id="ov17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;ROM trọng số + bias (O2, O3)&lt;/b&gt;&lt;br&gt;3 pROM, bias lưu chung ROM&lt;br&gt;5.344 trọng số INT8 + 66 bias (Dense 512 → 2)" vertex="1"><mxGeometry x="985" y="565" width="320" height="95" as="geometry" /></mxCell><mxCell id="ov18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Tài nguyên&lt;/b&gt; [ước tính + IPUG932]&lt;br&gt;Logic ~17–26 % · FF ~21–27 %&lt;br&gt;BSRAM: bộ tăng tốc 4 + M3 4 = 8/10 (dư 2) · nhân ~5/16" vertex="1"><mxGeometry x="1400" y="120" width="450" height="90" as="geometry" /></mxCell><mxCell id="ov19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Module WiFi UART&lt;/b&gt;&lt;br&gt;(modem dùng lệnh AT,&lt;br&gt;firmware gốc của hãng,&lt;br&gt;không lập trình thêm)&lt;hr&gt;chỉ kết nối WiFi + TCP" vertex="1"><mxGeometry x="1400" y="700" width="230" height="140" as="geometry" /></mxCell><mxCell id="ov20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Trình duyệt&lt;/b&gt;&lt;br&gt;điện thoại / PC&lt;br&gt;cùng mạng WiFi&lt;hr&gt;NORMAL / FALL · tư thế&lt;br&gt;trạng thái · nút Hủy" vertex="1"><mxGeometry x="1680" y="700" width="190" height="140" as="geometry" /></mxCell><mxCell id="ov21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Còi&lt;/b&gt; (GPIO)&lt;br&gt;cảnh báo chính" vertex="1"><mxGeometry x="345" y="905" width="170" height="70" as="geometry" /></mxCell><mxCell id="ov22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Nút&lt;/b&gt; (GPIO)&lt;br&gt;Hủy · giữ 3 s = SOS" vertex="1"><mxGeometry x="535" y="905" width="170" height="70" as="geometry" /></mxCell><mxCell id="ov23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Công tắc tải&lt;/b&gt; (GPIO từ M3)&lt;br&gt;cắt nguồn MPU6050 để khởi động lại&lt;br&gt;khi mất dữ liệu" vertex="1"><mxGeometry x="725" y="905" width="250" height="70" as="geometry" /></mxCell><mxCell id="ov24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Pin LiPo + mạch sạc&lt;/b&gt;&lt;br&gt;cấp nguồn cho board, cảm biến, module WiFi" vertex="1"><mxGeometry x="1000" y="905" width="300" height="70" as="geometry" /></mxCell><mxCell id="ov25" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=