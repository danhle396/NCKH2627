ov14" target="ov15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov31" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;startArrow=block;startFill=1;" value="đọc / ghi đệm" edge="1" source="ov15" target="ov16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov32" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="trọng số, bias" edge="1" source="ov17" target="ov15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov33" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" value="CLASS, SCORE" edge="1" source="ov11" target="ov8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov34" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="SUSPECT" edge="1" source="ov8" target="ov9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov35" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" value="xác nhận / bỏ" edge="1" source="ov10" target="ov9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov36" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" value="trạng thái, sự kiện" edge="1" source="ov9" target="ov13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov37" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d6b656;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;startArrow=block;startFill=1;" value="UART · lệnh AT" edge="1" source="ov13" target="ov19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov38" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d6b656;startArrow=block;startFill=1;" value="HTTP /data mỗi 300 ms&lt;br&gt;/huy, /bat" edge="1" source="ov19" target="ov20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov39" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="báo động" edge="1" source="ov9" target="ov21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov40" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" value="hủy / SOS" edge="1" source="ov22" target="ov9"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="fl" name="2. Luồng dữ liệu, tầng 1 + tầng 2"><mxGraphModel dx="1600" dy="950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="fl1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Luồng dữ liệu mỗi chu kỳ 0,32 s — tầng 1 (CNN trên FPGA) và tầng 2 (4 dấu hiệu vật lý trên M3)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Đề xuất, chưa thực hiện (9/11/2026). Số có nhãn [ước tính] chưa đo; [mô phỏng] = mô phỏng RTL 14/10.&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="20" width="1600" height="70" as="geometry" /></mxCell><mxCell id="fl2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;① Mẫu thô 100 Hz&lt;/b&gt; (M3)&lt;br&gt;ax ay az gx gy gz theo trục người, đã trừ độ lệch" vertex="1"><mxGeometry x="720" y="110" width="360" height="75" as="geometry" /></mxCell><mxCell id="fl3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="TẦNG 1 — CNN (nghi ngờ)" vertex="1"><mxGeometry x="40" y="220" width="780" height="640" as="geometry" /></mxCell><mxCell id="fl4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;② Tiền xử lý&lt;/b&gt; (M3)&lt;br&gt;lọc [1 3 3 1]/8 · 100 → 50 Hz · INT8&lt;br&gt;đủ 16 mẫu mới (0,32 s)&lt;br&gt;→ gửi 96 B sang FPGA" vertex="1"><mxGeometry x="70" y="270" width="330" height="105" as="geometry" /></mxCell><mxCell id="fl5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;③ Ghi APB&lt;/b&gt; (M3 → FPGA)&lt;br&gt;chờ BUSY = 0 · ghi 96 B vào NEW_DATA&lt;br&gt;ghi CTRL.START" vertex="1"><mxGeometry x="70" y="410" width="330" height="90" as="geometry" /></mxCell><mxCell id="fl6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;④ Bộ tăng tốc kiểu mới (FPGA)&lt;/b&gt;&lt;hr&gt;chỉ tính vị trí mới + sát mép:&lt;br&gt;L1: 8 · L2: 4 · L3: 2 đầu ra mới&lt;br&gt;kết quả cũ giữ trong đệm vòng&lt;br&gt;Dense đọc đủ 512 đặc trưng → logit&lt;br&gt;argmax → CLASS, SCORE&lt;hr&gt;~30–39 nghìn MAC (E2: 227.328)&lt;br&gt;~1,3–1,7 ms ở 27 MHz [ước tính]" vertex="1"><mxGeometry x="460" y="270" width="330" height="230" as="geometry" /></mxCell><mxCell id="fl7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;⑤ Đọc APB&lt;/b&gt; (FPGA → M3)&lt;br&gt;DONE (USER_INT0), WARM = 8&lt;br&gt;→ đọc CLASS, SCORE&lt;br&gt;đổi mã 1 → 3 (CLS_FALL)" vertex="1"><mxGeometry x="70" y="540" width="330" height="95" as="geometry" /></mxCell><mxCell id="fl8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Bỏ phiếu&lt;/b&gt; (safety.c)&lt;hr&gt;bit = (CLASS == FALL &amp;amp;&amp;amp; SCORE ≥ T_SCORE)&lt;br&gt;dồn vào vote_bits (3 cửa sổ gần nhất)&lt;br&gt;&lt;b&gt;≥ 2/3 FALL&lt;/b&gt; + đang đeo&lt;br&gt;→ &lt;b&gt;SUSPECT&lt;/b&gt;" vertex="1"><mxGeometry x="70" y="675" width="330" height="150" as="geometry" /></mxCell><mxCell id="fl9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Ràng buộc&lt;/b&gt;&lt;hr&gt;• chỉ gửi mẫu mới, M3 không giữ cửa sổ 768 B&lt;br&gt;• 8 bước đầu (2,56 s) chưa có kết quả&lt;br&gt;• ghi khi BUSY → WR_REJECT · tự kiểm 8 bước" vertex="1"><mxGeometry x="460" y="540" width="330" height="120" as="geometry" /></mxCell><mxCell id="fl10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="TẦNG 2 — 4 dấu hiệu vật lý (xác nhận), nga.c trên M3" vertex="1"><mxGeometry x="860" y="220" width="1000" height="640" as="geometry" /></mxCell><mxCell id="fl11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;nga_mau()&lt;/b&gt; — mỗi mẫu&lt;br&gt;đỉnh |a|², đỉnh |ω|²&lt;br&gt;tổng ax, ay, az của khối" vertex="1"><mxGeometry x="890" y="270" width="300" height="90" as="geometry" /></mxCell><mxCell id="fl12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;nga_khoi()&lt;/b&gt; — mỗi 32 mẫu&lt;br&gt;lưu đỉnh, cờ nghiêng, tư thế&lt;br&gt;(posture.c)&lt;br&gt;lịch sử 36 khối (11,5 s)" vertex="1"><mxGeometry x="890" y="395" width="300" height="105" as="geometry" /></mxCell><mxCell id="fl13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;nga_bat_dau()&lt;/b&gt; — khi SUSPECT&lt;br&gt;tìm khối va chạm trong lịch sử&lt;br&gt;&lt;b&gt;nga_buoc()&lt;/b&gt; — mỗi 10 ms, ≤ 4 s" vertex="1"><mxGeometry x="890" y="540" width="300" height="105" as="geometry" /></mxCell><mxCell id="fl14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;4 dấu hiệu — phải ĐỦ CẢ BỐN&lt;/b&gt;&lt;hr&gt;&lt;table style=&quot;font-size:12px;border-collapse:collapse&quot; border=&quot;1&quot; cellpadding=&quot;4&quot;&gt;&lt;tr&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Đeo ngực (nga.c hiện tại)&lt;/th&gt;&lt;th&gt;Đeo bắp tay&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;trước đó ngực thẳng&lt;/td&gt;&lt;td&gt;pha rơi trước va chạm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;va chạm ≥ 2,5 g&lt;/td&gt;&lt;td&gt;va chạm mạnh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;quay ≥ 220 °/s&lt;/td&gt;&lt;td&gt;quay cánh tay lớn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;ngực nghiêng ≥ 45°&lt;/td&gt;&lt;td&gt;bất động sau va chạm&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Ngưỡng ngực chọn từ log 28/10 (1 người).&lt;br&gt;&lt;b&gt;Bắp tay: viết lại dấu hiệu 1, 4; chọn lại mọi ngưỡng.&lt;/b&gt;" vertex="1"><mxGeometry x="1240" y="270" width="590" height="375" as="geometry" /></mxCell><mxCell id="fl15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Thiếu dấu hiệu / quá 4 s&lt;/b&gt;&lt;br&gt;→ BỎ (safety_bo_nghi), về MONITOR&lt;br&gt;còi, web không thấy" vertex="1"><mxGeometry x="1240" y="680" width="280" height="80" as="geometry" /></mxCell><mxCell id="fl16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Đủ 4 dấu hiệu&lt;/b&gt;&lt;br&gt;→ XÁC NHẬN NGÃ" vertex="1"><mxGeometry x="1550" y="680" width="280" height="80" as="geometry" /></mxCell><mxCell id="fl17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Safety FSM + đầu ra (M3)" vertex="1"><mxGeometry x="40" y="900" width="1820" height="300" as="geometry" /></mxCell><mxCell id="fl18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;MONITOR&lt;/b&gt;" vertex="1"><mxGeometry x="70" y="960" width="170" height="70" as="geometry" /></mxCell><mxCell id="fl19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;SUSPECT&lt;/b&gt;&lt;br&gt;bíp 0,4 s/giây&lt;br&gt;→ gọi nga_bat_dau()" vertex="1"><mxGeometry x="290" y="960" width="170" height="70" as="geometry" /></mxCell><mxCell id="fl20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;XÁC NHẬN NGÃ&lt;/b&gt;&lt;br&gt;kiểm bất động" vertex="1"><mxGeometry x="510" y="960" width="200" height="70" as="geometry" /></mxCell><mxCell id="fl21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Đếm ngược 10 s&lt;/b&gt;&lt;br&gt;khi người bất động" vertex="1"><mxGeometry x="760" y="960" width="200" height="70" as="geometry" /></mxCell><mxCell id="fl22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;BÁO ĐỘNG&lt;/b&gt;&lt;br&gt;còi liên tục" vertex="1"><mxGeometry x="1010" y="960" width="180" height="70" as="geometry" /></mxCell><mxCell id="fl23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;⑦ Web server trên M3&lt;/b&gt; (lệnh AT)&lt;hr&gt;GET / → trang web nén (flash M3)&lt;br&gt;GET /data → JSON trạng thái&lt;br&gt;POST /huy → hủy · /bat → bật lại" vertex="1"><mxGeometry x="1240" y="930" width="280" height="130" as="geometry" /></mxCell><mxCell id="fl24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;⑧ Module WiFi UART&lt;/b&gt; (modem AT)&lt;br&gt;chỉ truyền TCP, không xử lý&lt;hr&gt;&lt;b&gt;⑨ Trình duyệt&lt;/b&gt;&lt;br&gt;/data mỗi 300 ms · nút Hủy" vertex="1"><mxGeometry x="1570" y="930" width="260" height="130" as="geometry" /></mxCell><mxCell id="fl25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Hủy&lt;/b&gt;: nút trên thiết bị hoặc nút Hủy trên web (H) → về MONITOR" vertex="1"><mxGeometry x="510" y="1090" width="450" height="60" as="geometry" /></mxCell><mxCell id="fl26" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="nhánh tầng 1" edge="1" source="fl2" target="fl4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl27" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="nhánh tầng 2 (không lọc)" edge="1" source="fl2" target="fl11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl28" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="96 B mẫu mới" edge="1" source="fl4" target="fl5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl29" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" value="APB" edge="1" source="fl5" target="fl6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl30" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" value="DONE" edge="1" source="fl6" target="fl7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl31" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="CLASS, SCORE" edge="1" source="fl7" target="fl8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl32" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="" edge="1" source="fl11" target="fl12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl33" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="" edge="1" source="fl12" target="fl13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl34" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" value="tính 4 dấu hiệu" edge="1" source="fl13" target="fl14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl35" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="" edge="1" source="fl14" target="fl15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl36" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="" edge="1" source="fl14" target="fl16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl37" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="SUSPECT" edge="1" source="fl8" target="fl19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl38" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="≥ 2/3 FALL" edge="1" source="fl18" target="fl19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl39" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="đủ 4" edge="1" source="fl19" target="fl20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl40" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="bất động" edge="1" source="fl20" target="fl21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl41" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;" value="hết 10 s" edge="1" source="fl21" target="fl22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl42" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="" edge="1" source="fl16" target="fl20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl43" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="sự kiện" edge="1" source="fl22" target="fl23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl44" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d6b656;startArrow=block;startFill=1;" value="UART" edge="1" source="fl23" target="fl24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl45" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" value="" edge="1" source="fl25" target="fl18"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="fp" name="3. FPGA sau tối ưu (O1 O2 O4)"><mxGraphModel dx="1600" dy="950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="fp1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Khối FPGA trên GW1NSR-LV4C sau tối ưu — cổng APB, bộ tăng tốc kiểu mới, đệm đặc trưng, ROM gộp&lt;/b&gt;&lt;br&gt;&lt;i&gt;Đề xuất, chưa thực hiện (9/11/2026). Số có nhãn [ước tính] chưa đo; [mô phỏng] = mô phỏng RTL 14/10.&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="20" width="1600" height="70" as="geometry" /></mxCell><mxCell id="fp2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Cortex-M3&lt;/b&gt; (Gowin_EMPU)&lt;br&gt;SRAM 8 KB = 4 BSRAM*&lt;br&gt;flash 32 KB&lt;br&gt;33 LUT · 19 FF (IPUG932)" vertex="1"><mxGeometry x="40" y="160" width="220" height="120" as="geometry" /></mxCell><mxCell id="fp3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Cổng APB — APB2 Master 1, 0x40002400, 256 B (O4)&lt;/b&gt;&lt;hr&gt;&lt;table style=&quot;font-size:12px;border-collapse:collapse&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;Offset&lt;/th&gt;&lt;th&gt;Tên&lt;/th&gt;&lt;th&gt;R/W&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x00&lt;/td&gt;&lt;td&gt;ID&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x04&lt;/td&gt;&lt;td&gt;CTRL: START, SOFT_RST&lt;/td&gt;&lt;td&gt;W&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x08&lt;/td&gt;&lt;td&gt;STATUS: BUSY, DONE, WR_REJECT&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0C&lt;/td&gt;&lt;td&gt;CLASS&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x10&lt;/td&gt;&lt;td&gt;SCORE&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x14–0x18&lt;/td&gt;&lt;td&gt;LOGIT0..1 (INT32, NORMAL / FALL)&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x24&lt;/td&gt;&lt;td&gt;CYCLES&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x28&lt;/td&gt;&lt;td&gt;NEW_DATA: 1 B mẫu mới, con trỏ tự tăng (96 B/bước)&lt;/td&gt;&lt;td&gt;W&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x2C&lt;/td&gt;&lt;td&gt;WARM: số bước đã có trong đệm (0…8)&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x30 / 0x34&lt;/td&gt;&lt;td&gt;WROM_ADDR / WROM_DATA (O7)&lt;/td&gt;&lt;td&gt;R/W · R&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;DONE → USER_INT0" vertex="1"><mxGeometry x="320" y="120" width="470" height="360" as="geometry" /></mxCell><mxCell id="fp4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Bộ tăng tốc kiểu mới (cnn_inc.v)&lt;/b&gt;&lt;hr&gt;dùng lại khối tính của cnn_e2: MAC, lượng tử, ReLU, gộp, Dense&lt;br&gt;điều khiển mới: chỉ tính vị trí mới + sát mép&lt;br&gt;Conv1D k=5: 6→16→16→32 · Dense 512 → 2 (O3)&lt;br&gt;1 làn MAC · ~35–45 nghìn chu kỳ / bước [ước tính]" vertex="1"><mxGeometry x="860" y="120" width="420" height="200" as="geometry" /></mxCell><mxCell id="fp5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Đệm đặc trưng 2.048 × 8 — 1 SDPB (O1)&lt;/b&gt;&lt;hr&gt;&lt;table style=&quot;font-size:12px;border-collapse:collapse&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td&gt;0x000–0x3FF&lt;/td&gt;&lt;td&gt;đệm L1 (64 × 16)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x400–0x5FF&lt;/td&gt;&lt;td&gt;đệm L2 (32 × 16)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x600–0x7FF&lt;/td&gt;&lt;td&gt;đệm L3 (16 × 32)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;đệm vòng: mỗi bước ghi đè phần cũ nhất&lt;br&gt;16 mẫu mới + 4 mẫu cũ (120 B) trong RAM LUT" vertex="1"><mxGeometry x="860" y="380" width="420" height="250" as="geometry" /></mxCell><mxCell id="fp6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;ROM gộp trọng số + bias (O2, O3) — 3 pROM&lt;/b&gt;&lt;hr&gt;&lt;table style=&quot;font-size:12px;border-collapse:collapse&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;Nội dung&lt;/th&gt;&lt;th&gt;Địa chỉ (1 làn)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Conv1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Conv2&lt;/td&gt;&lt;td&gt;480&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Conv3&lt;/td&gt;&lt;td&gt;1.760&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Dense 512 → 2 (1.024 trọng số)&lt;/td&gt;&lt;td&gt;4.320&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bias (66 × 4 B)&lt;/td&gt;&lt;td&gt;5.344 → tổng 5.608 từ = 3 khối&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;bỏ 2 logit dự trữ: −1.024 trọng số (−16 %)" vertex="1"><mxGeometry x="1340" y="120" width="480" height="300" as="geometry" /></mxCell><mxCell id="fp7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Một xung nhịp (O5)&lt;/b&gt;&lt;br&gt;thạch anh, không PLL&lt;br&gt;chung cho M3 và FPGA&lt;br&gt;27 MHz, chân 45 [sơ đồ NL]" vertex="1"><mxGeometry x="40" y="340" width="220" height="90" as="geometry" /></mxCell><mxCell id="fp8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Ngân sách tài nguyên&lt;/b&gt; [ước tính + IPUG932]&lt;hr&gt;&lt;table style=&quot;font-size:12px;border-collapse:collapse&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Ước tính&lt;/th&gt;&lt;th&gt;Có&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Logic&lt;/td&gt;&lt;td&gt;~785–1.180 (17–26 %)&lt;/td&gt;&lt;td&gt;4.608&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FF&lt;/td&gt;&lt;td&gt;~720–920 (21–27 %)&lt;/td&gt;&lt;td&gt;3.456&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BSRAM bộ tăng tốc&lt;/td&gt;&lt;td&gt;4 = ROM 3 + đệm 1&lt;/td&gt;&lt;td rowspan=&quot;2&quot;&gt;10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BSRAM M3&lt;/td&gt;&lt;td&gt;4 (IPUG932 bảng 1-2)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bộ nhân 18×18&lt;/td&gt;&lt;td&gt;~5&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry x="320" y="520" width="470" height="210" as="geometry" /></mxCell><mxCell id="fp9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Kiểm chứng 4 cấp&lt;/b&gt; — golden E2 + golden tăng dần (golden_inc.py) → mô phỏng RTL Icarus -g2001 (tb_inc.v, testbench APB)&lt;br&gt;→ netlist sau đặt – nối dây trên GW1NSR-LV4C → board (tự kiểm khi bật nguồn, đối chiếu khi chạy).&lt;br&gt;&lt;b&gt;Pass mỗi bước:&lt;/b&gt; 50 bước liên tiếp khớp bit ở mọi tầng (gồm 8 bước khởi động)." vertex="1"><mxGeometry x="860" y="690" width="960" height="110" as="geometry" /></mxCell><mxCell id="fp10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Cần xác minh trước (bước S0)&lt;/b&gt;&lt;br&gt;* 4 BSRAM của EMPU ứng với SRAM bao nhiêu KB · SDPB trên GW1NS-4&lt;br&gt;khớp bit của bộ tăng tốc kiểu mới (làm golden trước) · tần số thạch anh · nguồn 3,3 V cho module WiFi" vertex="1"><mxGeometry x="40" y="760" width="750" height="110" as="geometry" /></mxCell><mxCell id="fp11" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;startArrow=block;startFill=1;" value="APB2" edge="1" source="fp2" target="fp3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fp12" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;startArrow=block;startFill=1;" value="START / DONE · kết quả" edge="1" source="fp3" target="fp4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fp13" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" value="NEW_DATA (khi BUSY = 0)" edge="1" source="fp3" target="fp5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fp14" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;startArrow=block;startFill=1;" value="đọc / ghi đặc trưng" edge="1" source="fp4" target="fp5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fp15" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="trọng số, bias" edge="1" source="fp6" target="fp4"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>