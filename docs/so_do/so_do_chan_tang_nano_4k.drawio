unded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="GND" vertex="1"><mxGeometry x="1470" y="294" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_22" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;strokeWidth=2;" value="&lt;b&gt;Boost 3,7 → 5 V&lt;/b&gt; (≥ 1 A)&lt;br&gt;&lt;font color='#666666' style='font-size:12px'&gt;vào: pin LiPo 1S → module sạc có bảo vệ&lt;br&gt;→ công tắc nguồn · không cắm USB-C cùng lúc [CẦN XÁC MINH]&lt;/font&gt;" vertex="1"><mxGeometry x="1600" y="254" width="330" height="80" as="geometry" /></mxCell><mxCell id="t3_23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="VCC (qua Q3)" vertex="1"><mxGeometry x="1470" y="374" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="bật nguồn (Q2)" vertex="1"><mxGeometry x="1470" y="414" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_25" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="SCL" vertex="1"><mxGeometry x="1470" y="454" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_26" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="SDA" vertex="1"><mxGeometry x="1470" y="494" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_27" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="INT" vertex="1"><mxGeometry x="1470" y="534" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="GND" vertex="1"><mxGeometry x="1470" y="574" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_29" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;strokeWidth=2;" value="&lt;b&gt;MPU6050&lt;/b&gt; (module GY-521)&lt;br&gt;&lt;font color='#666666' style='font-size:12px'&gt;cảm biến gia tốc + con quay · I²C 0x68 (AD0 nối GND)&lt;br&gt;module có sẵn ổn áp, kéo lên I²C, tụ · XDA, XCL để trống&lt;br&gt;nguồn qua Q3 S8550 (Q2 S8050 lái)&lt;br&gt;tụ 10 µF + 100 nF, điện trở xả 4,7 kΩ ở chân VCC&lt;br&gt;cắm header cái 1 × 8, không dây dupont&lt;br&gt;&lt;b&gt;treo thì tự cắt nguồn gỡ (mục 7.5)&lt;/b&gt;&lt;/font&gt;" vertex="1"><mxGeometry x="1600" y="374" width="330" height="240" as="geometry" /></mxCell><mxCell id="t3_30" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="RXD (chân 4)" vertex="1"><mxGeometry x="1470" y="654" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_31" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="TXD (chân 5)" vertex="1"><mxGeometry x="1470" y="694" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_32" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="RST (7) qua Q1" vertex="1"><mxGeometry x="1470" y="734" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="VIN ổn áp" vertex="1"><mxGeometry x="1470" y="774" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" value="GND" vertex="1"><mxGeometry x="1470" y="814" width="130" height="40" as="geometry" /></mxCell><mxCell id="t3_35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;strokeWidth=2;" value="&lt;b&gt;ESP-01S&lt;/b&gt; 