trokeColor=#6c8ebf;" value="P7-5" vertex="1"><mxGeometry x="590" y="510" width="55" height="30" as="geometry" /></mxCell><mxCell id="t1_151" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="LED DS3 trên board" vertex="1"><mxGeometry x="645" y="510" width="270" height="30" as="geometry" /></mxCell><mxCell id="t1_152" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Chân MODE, dùng làm GPIO" vertex="1"><mxGeometry x="915" y="510" width="290" height="30" as="geometry" /></mxCell><mxCell id="t1_153" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="" vertex="1"><mxGeometry x="30" y="560" width="26" height="20" as="geometry" /></mxCell><mxCell id="t1_154" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="Dùng, bank 3,3 V" vertex="1"><mxGeometry x="60" y="561" width="170" height="20" as="geometry" /></mxCell><mxCell id="t1_155" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#ffe6cc;strokeColor=#d79b00;" value="" vertex="1"><mxGeometry x="235" y="560" width="26" height="20" as="geometry" /></mxCell><mxCell id="t1_156" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="Dùng, bank 1,8 V" vertex="1"><mxGeometry x="265" y="561" width="170" height="20" as="geometry" /></mxCell><mxCell id="t1_157" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="" vertex="1"><mxGeometry x="440" y="560" width="26" height="20" as="geometry" /></mxCell><mxCell id="t1_158" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="Linh kiện có sẵn trên board" vertex="1"><mxGeometry x="470" y="561" width="170" height="20" as="geometry" /></mxCell><mxCell id="t1_159" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#fff2cc;strokeColor=#d6b656;" value="" vertex="1"><mxGeometry x="645" y="560" width="26" height="20" as="geometry" /></mxCell><mxCell id="t1_160" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="Dự phòng" vertex="1"><mxGeometry x="675" y="561" width="170" height="20" as="geometry" /></mxCell><mxCell id="t1_161" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#eeeeee;strokeColor=#999999;fontColor=#777777;" value="" vertex="1"><mxGeometry x="850" y="560" width="26" height="20" as="geometry" /></mxCell><mxCell id="t1_162" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="Không dùng" vertex="1"><mxGeometry x="880" y="561" width="170" height="20" as="geometry" /></mxCell><mxCell id="t1_163" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#f8cecc;strokeColor=#b85450;" value="" vertex="1"><mxGeometry x="1055" y="560" width="26" height="20" as="geometry" /></mxCell><mxCell id="t1_164" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="Nguồn" vertex="1"><mxGeometry x="1085" y="561" width="170" height="20" as="geometry" /></mxCell><mxCell id="t1_165" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;" value="Chân trống còn lại và chân không dùng" vertex="1"><mxGeometry x="30" y="600" width="610" height="250" as="geometry" /></mxCell><mxCell id="t1_166" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b&gt;Dự phòng 1,8 V&lt;/b&gt; (bank 3): chân 13 (P6-12), 19 (P6-9), 20 (P6-8), 21 (P6-7), 22 (P6-6), 23 (P6-5). Chỉ nối thiết bị chạy 1,8 V, hoặc qua transistor như wifi_rst, sens_pwr, buz.&lt;br&gt;&lt;br&gt;&lt;b&gt;3,3 V: không còn chân trống.&lt;/b&gt; Bank 1 dùng hết 7 chân 39–44, 46. Nếu cần thêm: chân 1, 47, 48 (đang nối flash SPI P25Q32), phải giữ chân 2 (MSPI_CS) ở mức 1 [CẦN XÁC MINH].&lt;br&gt;&lt;br&gt;&lt;b&gt;Không dùng:&lt;/b&gt; 2, 8, 9 (flash SPI); 3, 4, 6, 7 (JTAG, nối BL702); 27–35 (HDMI và DVP_XCLK, bank 2 = 2,5 V)." vertex="1"><mxGeometry x="42" y="632" width="590" height="215" as="geometry" /></mxCell><mxCell id="t1_167" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;" value="GPIO của lõi M3 (Gowin_EMPU, gpio[15:0])" vertex="1"><mxGeometry x="660" y="600" width="610" height="250" as="geometry" /></mxCell><mxCell id="t1_168" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="0 imu_scl · 1 imu_sda · 2 imu_int · 3 wifi_rst · 4 sens_pwr · 5 buz · 6 btn_n · 7 led · 8 buz_2khz · 9–15 trống.&lt;br&gt;Còi: gpio[5] bật/tắt; gpio[8] = 0 mức cao liên tục (còi chủ động), 1 = FPGA phát 2 kHz (còi thụ động).&lt;br&gt;&lt;br&gt;I²C mềm (O6): ghi 0 vào bit dữ liệu, bật/tắt cho phép xuất để kéo xuống hoặc thả (cực máng hở). Điện trở kéo lên: R29, R30 sẵn trên board (2,5 V) và trên GY-521.&lt;br&gt;&lt;br&gt;UART0 ↔ ESP-01S (lệnh AT), UART1 ↔ USB–UART (gỡ lỗi; in thanh ghi CYCLES để đo thời gian suy luận).&lt;br&gt;&lt;br&gt;Bank 3 phải khai báo &lt;b&gt;BANK_VCCIO=1.8&lt;/b&gt; trong .cst, theo key_blink.cst của Sipeed." vertex="1"><mxGeometry x="672" y="632" width="590" height="215" as="geometry" /></mxCell><mxCell id="t1_169" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;" value="&lt;i&gt;Nguồn: sơ đồ nguyên lý Tang Nano 4K bản 3603 (Sipeed, 20/8/2021); bảng chân gói QFN48P trong Gowin EDA 1.9.11.03; file .cst mẫu của sipeed/TangNano-4K-example; ESP-01S Specification (Ai-Thinker); MPU-6050 Product Spec Rev 3.4; IPUG932. Bản sao: docs/datasheet/tang_nano_4k/&lt;/i&gt;" vertex="1"><mxGeometry x="30" y="865" width="1240" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="t2_" name="2. Header P6, P7"><mxGraphModel dx="1600" dy="950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t2_1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b style='font-size:20px'&gt;Hai hàng header P6, P7 của Tang Nano 4K: chân nào dùng cho việc gì&lt;/b&gt;" vertex="1"><mxGeometry x="30" y="15" width="1240" height="40" as="geometry" /></mxCell><mxCell id="t2_2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="Mỗi hàng: chân chip · tên trên sơ đồ nguyên lý | số chân header | tín hiệu của đề tài. Đánh số theo sơ đồ nguyên lý; vị trí chân 1 trên board phải kiểm bằng mắt hoặc đồng hồ đo trước khi hàn [CẦN XÁC MINH]." vertex="1"><mxGeometry x="30" y="52" width="1240" height="25" as="geometry" /></mxCell><mxCell id="t2_3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#444444;strokeColor=#444444;fontColor=#ffffff;fontStyle=1;" value="Chân chip · tên trên sơ đồ" vertex="1"><mxGeometry x="30" y="90" width="250" height="34" as="geometry" /></mxCell><mxCell id="t2_4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=4;fillColor=#444444;strokeColor=#444444;fontColor=#ffffff;fontStyle=1;align=center;" value="P6" vertex="1"><mxGeomet